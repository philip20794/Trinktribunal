{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "canonicalization",
    "catalogs"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "canonicalization": {
      "const": "sorted-keys-utf16-json-v1"
    },
    "catalogs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "source",
          "kind",
          "language",
          "formatVersion",
          "ids",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(questions|rules)/(de|en)\\.json$"
          },
          "source": {
            "type": "string",
            "pattern": "^data/(questions/top-ten|rules)/(de|en)\\.json$"
          },
          "kind": {
            "enum": [
              "questions",
              "rules"
            ]
          },
          "language": {
            "enum": [
              "de",
              "en"
            ]
          },
          "formatVersion": {
            "const": 1
          },
          "ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
