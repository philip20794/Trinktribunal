        "activeRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignment"
          },
          "minItems": 0,
          "maxItems": 25,
          "uniqueItems": true
        },
        "completedCases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 491
        },
        "revealCursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "revealed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revealed"
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "judgeOrder": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true
        },
        "result": {
          "$ref": "#/$defs/publicResult"
        },
        "pauseReason": {
          "enum": [
            "insufficient_players",
            "content_exhausted",
            "host_unavailable"
          ]
        },
        "expiresAtUtc": {
          "$ref": "#/$defs/utc"
        },
        "pausedFrom": {
          "enum": [
            "lobby",
            "case_boundary",
            "numbers",
            "answers",
            "ordering",
            "revealing",
            "judged",
            "rule_event"
          ]
        }
      }
    },
