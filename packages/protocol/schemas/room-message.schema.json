{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trinktribunal room messages v1",
  "oneOf": [
    {
      "$ref": "#/$defs/create"
    },
    {
      "$ref": "#/$defs/join"
    },
    {
      "$ref": "#/$defs/credential"
    },
    {
      "$ref": "#/$defs/authenticate"
    },
    {
      "$ref": "#/$defs/leaveHttp"
    },
    {
      "$ref": "#/$defs/authenticated"
    },
    {
      "$ref": "#/$defs/requestSnapshot"
    },
    {
      "$ref": "#/$defs/setConfig"
    },
    {
      "$ref": "#/$defs/startGame"
    },
    {
      "$ref": "#/$defs/restartGame"
    },
    {
      "$ref": "#/$defs/editOwnProfile"
    },
    {
      "$ref": "#/$defs/reorderRoster"
    },
    {
      "$ref": "#/$defs/kick"
    },
    {
      "$ref": "#/$defs/leave"
    },
    {
      "$ref": "#/$defs/closeRoom"
