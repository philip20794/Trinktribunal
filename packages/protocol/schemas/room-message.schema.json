    {
      "$ref": "#/$defs/acknowledgeNumber"
    },
    {
      "$ref": "#/$defs/beginOrdering"
    },
    {
      "$ref": "#/$defs/submitOrder"
    },
    {
      "$ref": "#/$defs/revealNext"
    },
    {
      "$ref": "#/$defs/completeCase"
    },
    {
      "$ref": "#/$defs/completeWithoutVerdict"
    },
    {
      "$ref": "#/$defs/continueRule"
    },
    {
      "$ref": "#/$defs/resumePaused"
    },
    {
      "$ref": "#/$defs/historyImport"
    },
    {
      "$ref": "#/$defs/historyBegin"
    },
    {
      "$ref": "#/$defs/historyStatus"
    },
    {
      "$ref": "#/$defs/cancelHistoryImport"
    },
    {
      "$ref": "#/$defs/historyPull"
    },
    {
      "$ref": "#/$defs/historyEvents"
    },
    {
      "$ref": "#/$defs/historyReceipt"
    },
    {
      "$ref": "#/$defs/ack"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/sessionReplaced"
    },
    {
      "$ref": "#/$defs/roomClosed"
    },
    {
      "$ref": "#/$defs/ping"
    },
    {
      "$ref": "#/$defs/pong"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/delta"
    },
    {
      "$ref": "#/$defs/projectionStart"
    },
    {
      "$ref": "#/$defs/projectionChunk"
    },
    {
      "$ref": "#/$defs/projectionEnd"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "maxLength": 64
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "maxLength": 43
    },
    "roomCode": {
      "type": "string",
      "pattern": "^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{8}$",
      "maxLength": 8
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "maxLength": 24
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetCases",
        "requestedRuleEvents",
        "factorTenths",
        "allJudges",
        "contentLanguage"
      ],
      "properties": {
        "targetCases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 491
        },
        "requestedRuleEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "factorTenths": {
          "type": "integer",
          "minimum": 10,
          "maximum": 30
        },
        "allJudges": {
          "type": "boolean"
        },
        "contentLanguage": {
          "enum": [
            "de",
            "en"
          ]
        }
      }
    },
    "handshake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "catalogHash",
        "avatarVersion"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "catalogHash": {
          "$ref": "#/$defs/hash"
        },
        "avatarVersion": {
          "const": 1
        }
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "selections"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "selections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "face",
            "skin",
            "eyes",
            "brows",
            "nose",
            "mouth",
            "hair",
            "hairColor",
            "beard",
            "top",
            "topColor",
            "glasses",
            "hat",
            "extra"
          ],
          "properties": {
            "face": {
              "enum": [
                "round",
                "square",
                "long"
              ]
            },
            "skin": {
              "enum": [
                "light",
                "medium",
                "brown",
                "dark"
              ]
            },
            "eyes": {
              "enum": [
                "open",
                "sleepy"
              ]
            },
            "brows": {
              "enum": [
                "calm",
                "raised"
              ]
            },
            "nose": {
              "enum": [
                "round",
                "long"
              ]
            },
            "mouth": {
              "enum": [
                "smile",
                "neutral",
                "surprised"
              ]
            },
            "hair": {
              "enum": [
                "short",
                "curly",
                "long",
                "bald"
              ]
            },
            "hairColor": {
              "enum": [
                "brown",
                "black",
                "gold",
                "gray"
              ]
            },
            "beard": {
              "enum": [
                "none",
                "stubble",
                "full"
              ]
            },
            "top": {
              "enum": [
                "shirt",
                "jacket"
              ]
            },
            "topColor": {
              "enum": [
                "blue",
                "red",
                "green",
                "brown"
              ]
            },
            "glasses": {
              "enum": [
                "none",
                "round"
              ]
            },
            "hat": {
              "enum": [
                "none",
                "cap"
              ]
            },
            "extra": {
              "enum": [
                "none",
                "bowtie"
              ]
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "avatar"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "avatar": {
          "$ref": "#/$defs/avatar"
        }
      }
    },
    "historyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "kind",
        "contentId",
        "timestampUtc"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "question",
            "rule"
          ]
        },
        "contentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "maxLength": 64
        },
        "timestampUtc": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "historyOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importId",
        "count",
        "sha256"
      ],
      "properties": {
        "importId": {
          "$ref": "#/$defs/id"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "revealed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playerId",
        "number"
      ],
      "properties": {
        "playerId": {
          "$ref": "#/$defs/id"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "binding": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^player[1-9][0-9]*$",
        "maxLength": 16
      },
      "maxProperties": 20,
      "additionalProperties": {
        "$ref": "#/$defs/id"
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentId",
        "bindings"
      ],
      "properties": {
        "contentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "maxLength": 64
        },
        "bindings": {
          "$ref": "#/$defs/binding"
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playerId",
        "profile",
        "connected",
        "ready",
        "orderSubmitted"
      ],
      "properties": {
        "playerId": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "connected": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        },
        "orderSubmitted": {
          "type": "boolean"
        }
      }
    },
    "penalty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playerId",
        "sips"
      ],
      "properties": {
        "playerId": {
          "$ref": "#/$defs/id"
        },
        "sips": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "publicResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors",
        "penalties"
      ],
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "penalties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/penalty"
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        }
      }
    },
    "ownResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors",
        "sips"
      ],
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "sips": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "privateView": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "ownNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "ownOrder": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true
        },
        "ownResult": {
          "$ref": "#/$defs/ownResult"
        }
      }
    },
    "publicView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "hostId",
        "hostRevision",
        "config",
        "players",
        "frozenRoster",
        "pendingRoster",
        "gameId",
        "roundId",
        "judgeId",
        "readerId",
        "question",
        "activeRules",
        "completedCases",
        "revealCursor",
        "revealed",
        "expiresAtUtc"
      ],
      "properties": {
        "phase": {
          "enum": [
            "lobby",
            "numbers",
            "answers",
            "ordering",
            "revealing",
            "judged",
            "rule_event",
            "paused",
            "finished"
          ]
        },
        "hostId": {
          "$ref": "#/$defs/id"
        },
        "hostRevision": {
          "$ref": "#/$defs/revision"
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/participant"
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "frozenRoster": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "pendingRoster": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "gameId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "const": null
            }
          ]
        },
        "roundId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "const": null
            }
          ]
        },
        "judgeId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
