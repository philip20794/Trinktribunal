{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "questions",
  "type": "object",
  "required": [
    "version",
    "language",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "language": {
      "enum": [
        "de",
        "en"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "scale"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{3}-[ab]$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "players": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^player[1-9][0-9]*$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "selection"
              ],
              "additionalProperties": false,
              "properties": {
                "selection": {
                  "const": "random"
                },
                "differentFrom": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^player[1-9][0-9]*$"
                  }
                }
              }
            }
          },
          "scale": {
            "type": "object",
            "required": [
              "green",
              "connector",
              "red"
            ],
            "additionalProperties": false,
            "properties": {
              "green": {
                "type": "string",
                "minLength": 1
              },
              "connector": {
                "enum": [
                  "bis",
                  "to"
                ]
              },
              "red": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
