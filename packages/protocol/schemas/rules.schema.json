{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rules",
  "type": "object",
  "required": [
    "version",
    "language",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "language": {
      "enum": [
        "de",
        "en"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "excludes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "players": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^player[1-9][0-9]*$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "selection"
              ],
              "additionalProperties": false,
              "properties": {
                "selection": {
                  "const": "random"
                },
                "differentFrom": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^player[1-9][0-9]*$"
                  }
                }
              }
            }
          },
          "excludes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
